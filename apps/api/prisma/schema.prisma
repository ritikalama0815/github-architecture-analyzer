generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id           String    @id @default(uuid())
  name         String
  sourceType   String
  sourceUrl    String?
  status       String    @default("pending")
  healthScore  Int?
  errorMessage String?
  statsJson    Json?
  graphJson    Json?
  issuesJson   Json?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  workDir      String?

  @@index([createdAt])
}
